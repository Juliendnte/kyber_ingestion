# --- KyberIA API ---
KYBERIA_API_URL=http://localhost:8000
KYBERIA_API_TOKEN=

# --- HuggingFace Hub ---
# Token avec droits d'écriture (push dataset)
HF_TOKEN_WRITE=hf_...
# Token lecture seule (optionnel, pour séparer les accès)
HF_TOKEN=hf_...
# Organisation et dépôt cible
HF_ORG=ynov
HF_DATASET_REPO=ynov/kyberia-data
 